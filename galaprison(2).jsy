  console.log('%c║         By D4NG3R - 2025               ║', 'color: #7c3aed; font-weight: bold;');
  console.log('%c╚══════════════════════════════════════════╝', 'color: #7c3aed; font-weight: bold;');
  console.log('%c[✓] Bot cargado correctamente', 'color: #22c55e; font-weight: bold;');
  
})();
